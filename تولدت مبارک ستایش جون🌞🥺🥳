<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>هدیه مخفی برای ستایش 🎁</title>

<style>
body {
    margin: 0;
    font-family: Tahoma, sans-serif;
    background: linear-gradient(135deg, #ffd6e7, #fff0f7, #eadcff);
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    color: #71354f;
}

.card {
    width: 90%;
    max-width: 500px;
    background: rgba(255,255,255,.9);
    padding: 25px;
    border-radius: 30px;
    text-align: center;
    box-shadow: 0 15px 50px rgba(100,50,80,.2);
}

h1 {
    font-size: 27px;
}

button {
    border: none;
    border-radius: 50px;
    padding: 13px 25px;
    background: #ed6f9e;
    color: white;
    font-size: 16px;
    cursor: pointer;
}

.arena {
    height: 350px;
    margin-top: 15px;
    position: relative;
    overflow: hidden;
    border-radius: 25px;
    background: #fff1f7;
    border: 2px dashed #eca5c1;
}

.item {
    position: absolute;
    background: transparent;
    border: none;
    font-size: 35px;
    padding: 5px;
}

.secret {
    background: #fff4fa;
    padding: 20px;
    border-radius: 22px;
    line-height: 2;
    font-size: 17px;
}

.hidden {
    display: none;
}
</style>
</head>

<body>

<div class="card">

<!-- شروع -->
<div id="start">
    <div style="font-size:60px">🎁💗</div>
    <h1>یه هدیه مخفی برای ستایش</h1>

    <p>
        اگه واقعاً می‌خوای کادوتو باز کنی...
        باید از سه مرحله رد بشی 😈🎀
    </p>

    <button onclick="startGame()">شروع چالش ✨</button>
</div>


<!-- بازی -->
<div id="game" class="hidden">

    <h1 id="title">مرحله اول 💗</h1>

    <p id="hint">
        ۵ قلب واقعی رو پیدا کن!
        ولی بعضیا قلابی‌ان 👀
    </p>

    <p>
        مرحله: <b id="stage">۱</b> از ۳
    </p>

    <div class="arena" id="arena"></div>

</div>


<!-- پیام نهایی -->
<div id="final" class="hidden">

    <div style="font-size:65px">🎂💗🎀</div>

    <h1>رمز باز شد! 🔓✨</h1>

    <div class="secret">

        ستایش جون قشنگم، تولدت مبارکککک 🎂💗

        <br><br>

        ۲۸ شهریور برای من فقط یه تاریخ نیست؛
        روزیه که یکی از قشنگ‌ترین آدمای زندگیم
        به دنیا اومده 🥹🫂

        <br><br>

        امیدوارم سال جدید زندگیت پر از خنده،
        آرامش، اتفاقای خوب و کلی خاطره قشنگ باشه ✨🌸

        <br><br>

        خیلی خوشحالم که تورو دارم و امیدوارم
        بازم کنار هم کلی خاطره بسازیم
        و از خنده‌هامون دل‌درد بگیریم 😂😭💗

        <br><br>

        دوستت دارم ستایش جونم 🫶🏻
        <br>
        همیشه همین‌قدر قشنگ و مهربون بمون 🎀

    </div>

</div>

</div>


<script>

let currentStage = 1;
let found = 0;


/* شروع بازی */

function startGame() {

    document.getElementById("start").classList.add("hidden");

    document.getElementById("game").classList.remove("hidden");

    createStage();

}


/* ساخت مرحله */

function createStage() {

    const arena = document.getElementById("arena");

    arena.innerHTML = "";

    found = 0;


    if (currentStage === 1) {

        document.getElementById("title").innerText =
            "مرحله اول 💗";

        document.getElementById("hint").innerText =
            "۵ قلب واقعی رو پیدا کن؛ گل‌ها حواس‌پرت‌کنن! 👀";


        const positions = [
            [8,10],
            [70,8],
            [38,35],
            [78,65],
            [15,72],
            [48,15],
            [85,35],
            [25,45],
            [60,70],
            [40,80]
        ];


        positions.forEach((pos,index) => {

            const btn = document.createElement("button");

            btn.className = "item";

            btn.innerText =
                index < 5 ? "💗" : "🌸";

            btn.style.left = pos[0] + "%";
            btn.style.top = pos[1] + "%";


            btn.onclick = function() {

                if(index < 5) {

                    btn.innerText = "✨";

                    btn.disabled = true;

                    found++;

                    if(found === 5) {

                        nextStage();

                    }

                } else {

                    btn.innerText = "😈";

                    setTimeout(() => {

                        btn.innerText = "🌸";

                    },400);

                }

            };


            arena.appendChild(btn);

        });

    }


    /* مرحله دوم */

    else if(currentStage === 2) {

        document.getElementById("title").innerText =
            "مرحله دوم 🔐";

        document.getElementById("hint").innerText =
            "حروف «س → ت → ا → ی» رو به ترتیب پیدا کن!";


        const letters = [
            "ت","س","ی","ا",
            "س","ی","ت","ا",
            "ا","ت","ی","س"
        ];


        const answer = ["س","ت","ا","ی"];

        let step = 0;


        letters.forEach((letter,index) => {

            const btn = document.createElement("button");

            btn.className = "item";

            btn.innerText = letter;

            btn.style.left =
                (5 + (index % 4) * 25) + "%";

            btn.style.top =
                (5 + Math.floor(index / 4) * 30) + "%";


            btn.onclick = function() {

                if(letter === answer[step]) {

                    btn.innerText = "💖";

                    btn.disabled = true;

                    step++;


                    if(step === 4) {

                        nextStage();

                    }

                } else {

                    document.getElementById("hint").innerText =
                        "اشتباه شد 😈 دوباره از اول همین مرحله!";

                    setTimeout(createStage,800);

                }

            };


            arena.appendChild(btn);

        });

    }


    /* مرحله سوم */

    else {

        document.getElementById("title").innerText =
            "مرحله آخر 🎁";

        document.getElementById("hint").innerText =
            "کلید واقعی کادو رو پیدا کن! 🎀";


        const objects = [
            "🎈","🌸","⭐","🎀",
            "🧁","🎈","🌷","✨",
            "🎀","💐","⭐","🎈"
        ];


        objects.forEach((object,index) => {

            const btn = document.createElement("button");

            btn.className = "item";

            btn.innerText = object;

            btn.style.left =
                (5 + (index % 4) * 25) + "%";

            btn.style.top =
                (5 + Math.floor(index / 4) * 30) + "%";


            btn.onclick = function() {

                if(object === "🎀") {

                    btn.innerText = "🔓";

                    setTimeout(showFinal,700);

                } else {

                    btn.innerText = "😈";

                    setTimeout(() => {

                        btn.innerText = object;

                    },400);

                }

            };


            arena.appendChild(btn);

        });

    }

}


/* مرحله بعد */

function nextStage() {

    setTimeout(() => {

        currentStage++;

        document.getElementById("stage").innerText =
            currentStage;

        createStage();

    },700);

}


/* پیام نهایی */

function showFinal() {

    document.getElementById("game").classList.add("hidden");

    document.getElementById("final").classList.remove("hidden");

}

</script>

</body>
</html>
